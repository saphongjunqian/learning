{
  "name": "organizations",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "repository": "<Add your repository here>",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@sap/cds": "^8",
    "express": "^4",
    "@sap/xssec": "^4",
    "@cap-js/hana": "^1"
  },
  "devDependencies": {
    "@cap-js/cds-typer": "^0.25.0",
    "@cap-js/sqlite": "^1",
    "@sap/ux-specification": "^1.120.12",
    "rimraf": "^5.0.7"
  },
  "scripts": {
    "start": "cds-serve",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "undeploy": "cf undeploy organizations --delete-services"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db/org.sqlite"
        }
      },
      "[production]": {
        "auth": "xsuaa",
        "db": {
          "kind": "hana-cloud",
          "impl": "@cap-js/hana"
        }
      }
    }
  },
  "sapux": [
    "app/organizations",
    "app/organizations"
  ]
}
