{
  "name": "ac-toolset",
  "version": "1.1.4",
  "description": "A simple CAP project.",
  "repository": "<Add your repository here>",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@sap/cds": "^8.1.1",
    "@sap/cds-hana": "^2.0.0",
    "@sap/xssec": "^4.1.1",
    "express": "^4",
    "passport": "^0.7.0"
  },
  "devDependencies": {
    "@cap-js/cds-typer": "^0.25.0",
    "@cap-js/sqlite": "^1",
    "@sap/ux-specification": "^1.120.12",
    "rimraf": "^5.0.7"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-wordcollection": "cds watch --open wordcollection/webapp/index.html?sap-ui-xx-viewCache=false",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "undeploy": "cf undeploy ac-toolset --delete-services"
  },
  "sapux": [
    "app/wordcollection"
  ],
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db/wordcollection.sqlite"
        }
      },
      "[production]": {
        "auth": "xsuaa",
        "db": {
          "kind": "hana-cloud",
          "impl": "@sap/cds-hana",
          "deploy-format": "hdbtable"
        }
      }
    },
    "server": {
      "body_parser": {
        "limit": "1mb"
      }
    }
  }
}
